# Copiá este archivo a `.env` (que NO se commitea):  cp .env.example .env
# Estos valores son SOLO para desarrollo local.

# real = MongoDB + Redis + Neo4j  |  fake = todo en memoria (sin Docker)
ADAPTERS=real

# Conexiones cuando la API corre en tu máquina (fuera de Docker).
# Dentro de docker compose, compose.yaml las pisa con los nombres de servicio.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=nexus
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus-dev-password

# Parámetros de negocio
CACHE_TTL_SECONDS=60
RECENT_VIEWS_LIMIT=10

# Solo para los tests de aceptación
NEXUS_BASE_URL=http://localhost:8000
